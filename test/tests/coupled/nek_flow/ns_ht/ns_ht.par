[OCCA]
backend = CPU

[GENERAL]
polynomialOrder = 3
stopAt = endTime
endTime = 0.01
dt = 5e-3
timeStepper = tombo2
checkpointInterval = 0
scalars = temperature

[MESH]
file = ../../../common_inputs/brick.re2

[FLUID PRESSURE]
residualTol = 1e-6

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet, zeroDirichlet, zeroDirichlet, zeroDirichlet, zeroDirichlet, zeroDirichlet
residualTol = 1e-8

[SCALAR TEMPERATURE]
solver = none
boundaryTypeMap = zeroValue, zeroValue, zeroValue, zeroValue, zeroValue, zeroValue
